{
  "name": "@flagly/node",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": "false",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts*\" && tsc --noEmit",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "build": "tsdown"
  },
  "author": "hirotask",
  "dependencies": {
    "@flagly/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
