{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "types": [ "node" ],
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "isolatedDeclarations": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
  },
  "include": ["src"]
}

